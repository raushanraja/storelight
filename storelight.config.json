{
  "$schema": "./storelight.config.schema.json",
  "roots": [
    {
      "id": "demo",
      "label": "Demo docs",
      "path": "./content/demo",
      "include": [
        "**/*.md"
      ],
      "exclude": [
        "node_modules/**",
        ".git/**",
        "drafts/**"
      ]
    }
  ],
  "git": {
    "autoCommit": true,
    "debounceMs": 2500,
    "commitPrefix": "docs(storelight)"
  },
  "editor": {
    "autosaveMs": 900
  }
}
