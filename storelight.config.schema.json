{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storelight.local/storelight.config.schema.json",
  "title": "Storelight configuration",
  "description": "Content roots and commit behaviour for the Storelight local Markdown studio.",
  "type": "object",
  "additionalProperties": false,
  "required": ["roots", "git", "editor"],
  "properties": {
    "$schema": { "type": "string" },
    "roots": {
      "type": "array",
      "description": "Directories Storelight may read and write.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "path", "include", "exclude"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
            "description": "Stable id used in URLs and API calls. Must be unique."
          },
          "label": { "type": "string", "minLength": 1, "maxLength": 100 },
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Absolute, relative to this config file, or starting with ~/."
          },
          "include": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "default": ["**/*.md"]
          },
          "exclude": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "default": []
          }
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["autoCommit", "debounceMs", "commitPrefix"],
      "properties": {
        "autoCommit": { "type": "boolean", "default": true },
        "debounceMs": { "type": "integer", "minimum": 250, "maximum": 60000, "default": 2500 },
        "commitPrefix": { "type": "string", "minLength": 1, "maxLength": 80, "default": "docs(storelight)" }
      }
    },
    "editor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["autosaveMs"],
      "properties": {
        "autosaveMs": { "type": "integer", "minimum": 200, "maximum": 10000, "default": 900 }
      }
    }
  }
}
